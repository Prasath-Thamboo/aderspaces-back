# ─────────────────────────────────────────────
# Base de données
# ─────────────────────────────────────────────
DATABASE_URL=postgres://maisonprint:maisonprint_pwd@localhost:5432/maisonprint

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# Medusa
# ─────────────────────────────────────────────
BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:3000
JWT_SECRET=change_this_jwt_secret_in_production_min_32_chars
COOKIE_SECRET=change_this_cookie_secret_in_production_min_32_chars

# CORS : URLs autorisées à appeler l'API
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000

# Compte admin créé au seed (changer en prod !)
MEDUSA_ADMIN_EMAIL=admin@aderspace.fr
MEDUSA_ADMIN_PASSWORD=AdminSecure123!

# ─────────────────────────────────────────────
# MinIO (stockage S3-compatible, dev local)
# ─────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9002
MINIO_PUBLIC_URL=http://localhost:9002/maisonprint
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=maisonprint
MINIO_REGION=us-east-1

# ─────────────────────────────────────────────
# MeiliSearch
# ─────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKeyDevOnlyChangeInProd

# ─────────────────────────────────────────────
# Stripe — clé SECRÈTE + secret du webhook.
# Vide  → le checkout fonctionne en "paiement manuel" (pp_system_default),
#         pratique pour tester le tunnel sans compte Stripe.
# Rempli → le provider Stripe (pp_stripe_stripe) est chargé automatiquement.
#          Pensez à relancer `npm run seed` pour le rattacher à la région France,
#          et à renseigner NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY côté frontend/.env.
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Brevo (Phase 2 — laisser vide en dev initial)
# ─────────────────────────────────────────────
BREVO_API_KEY=VOTRE_CLE_API_BREVO
BREVO_FROM_EMAIL=noreply@aderspace.fr
BREVO_FROM_NAME=Aderspace
